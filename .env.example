# Copy to .env for local dev. NEVER commit a real secret.
# HMAC_SECRET comes from the zkVerify dashboard at agent registration
# (32-byte secret, shown exactly once).
HMAC_SECRET=

# Optional: GitHub-file seen-set persistence (Vercel path). Local dev uses
# the gh CLI auth instead. Leave unset to run in-memory only.
# GITHUB_TOKEN=

# Optional overrides (defaults: STORE_REPO=faaz12/zkverify-gatekeeper,
# STORE_FILE=data/seen-proofs.jsonl, STORE_BACKEND=github, STORE_BRANCH=main)
# STORE_BACKEND=memory
# STORE_FILE=data/seen-proofs.jsonl
# PROVE_TIMEOUT_MS=10000
